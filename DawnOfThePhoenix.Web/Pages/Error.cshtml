@page
@model ErrorModel
@{ ViewData["Title"] = "Something went wrong"; }
<section class="section">
    <p class="eyebrow">LET’S TRY THAT AGAIN</p>
    <h1 style="font-size:58px">A little pause.</h1>
    <p>We couldn’t complete that request. Please try again, or contact Dawn if the problem continues.</p>
    @if (Model.ShowRequestId)
    {
        <p>Reference: <code>@Model.RequestId</code></p>
    }
    <a class="button" href="/">Return to PhoenixRising <span>→</span></a>
</section>
