<section id="readings" class="section readings">
    <div class="section-top">
        <div>
            <p class="eyebrow">01 / A MOMENT FOR YOU</p>
            <h2>
                Choose what’s
                <br />
                <em>calling to you.</em>
            </h2>
        </div>
        <p>
            Space for your questions. Room for discovery.
            <br />
            Start with the session that feels right.
        </p>
    </div>
    <div class="reading-grid">
        <article class="reading-card">
            <span class="card-symbol" aria-hidden="true">☾</span>
            <p class="eyebrow">LIVE · 30 MINUTES</p>
            <h3>A moment of clarity</h3>
            <p>
                A focused, personal session to explore what’s on your mind through psychic, oracle,
                or intuitive guidance.
            </p>
            <div class="price">
                $30
                <span>/ session</span>
            </div>
            <button class="button outline" data-book="thirty">
                Schedule 30 minutes
                <span>↗</span>
            </button>
        </article>
        <article class="reading-card featured">
            <span class="card-label">MORE SPACE TO EXPLORE</span>
            <span class="card-symbol" aria-hidden="true">✧</span>
            <p class="eyebrow">LIVE · 60 MINUTES</p>
            <h3>A deeper connection</h3>
            <p>
                More time to follow the conversation, explore your questions, and discuss the
                spiritual gifts surfacing in your life.
            </p>
            <div class="price">
                $55
                <span>/ session</span>
            </div>
            <button class="button" data-book="hour">
                Schedule 60 minutes
                <span>↗</span>
            </button>
        </article>
        <article class="reading-card">
            <span class="card-symbol" aria-hidden="true">✴</span>
            <p class="eyebrow">WRITTEN · WITHIN 48 HOURS</p>
            <h3>Three little questions</h3>
            <p>
                Have something specific on your heart? Send three yes-or-no questions for a written
                reading from Dawn.
            </p>
            <div class="price">
                $30
                <span>/ three questions</span>
            </div>
            <button class="button outline" id="ask">
                Ask your questions
                <span>↗</span>
            </button>
        </article>
    </div>
    <p class="service-note">
        Every reading is personal. You’re welcome to bring a question—or simply your curiosity.
    </p>
</section>
