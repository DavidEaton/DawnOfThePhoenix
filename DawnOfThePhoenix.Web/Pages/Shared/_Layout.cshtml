@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#17171c" />
        <meta
            name="request-verification-token"
            content="@Antiforgery.GetAndStoreTokens(Context).RequestToken"
        />
        <title>@ViewData["Title"] | PhoenixRising</title>
        <meta
            name="description"
            content="Find a moment of clarity with Dawn at PhoenixRising. Psychic, medium, oracle and claircognizant readings. Live sessions from $30, or three yes/no questions for $30."
        />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <link rel="icon" href="~/assets/favicon.svg" type="image/svg+xml" />
        <script src="~/config.js" defer></script>
        <script type="module" src="~/js/site.js" asp-append-version="true"></script>
    </head>
    <body>
        <a class="skip" href="#main">Skip to content</a>
        <partial name="_Header" />
        <main id="main">@RenderBody()</main>
        <partial name="_Footer" />
        <partial name="_Dialog" />

        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>
